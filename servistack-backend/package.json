{
  "name": "servistack-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:cobertura": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.js",
    "lint": "eslint .",
    "lint:reporte": "eslint . -f json -o ../evidencias/eslint-backend.json",
    "prueba:humo": "node test/humo/prueba-humo.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/sdk-metrics": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "amqplib": "^2.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-oauth2-jwt-bearer": "^1.6.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "opossum": "^10.0.0",
    "pg": "^8.11.5",
    "pino": "^9.3.2",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0"
  }
}
